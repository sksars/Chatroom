{
  "entities": {
    "UserPrivate": {
      "title": "UserPrivate",
      "description": "Private user account profile containing PII isolated to the authenticated owner.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "format": "email",
          "maxLength": 254
        },
        "username": {
          "type": "string",
          "minLength": 3,
          "maxLength": 20,
          "pattern": "^[a-z0-9_]{3,20}$"
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 50
        },
        "photoURL": {
          "type": "string",
          "maxLength": 500
        },
        "about": {
          "type": "string",
          "maxLength": 140
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "email", "username", "displayName", "createdAt", "updatedAt"]
    },
    "PublicProfile": {
      "title": "PublicProfile",
      "description": "Publicly visible chat profile without PII for contact display and presence.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "username": {
          "type": "string",
          "minLength": 3,
          "maxLength": 20,
          "pattern": "^[a-z0-9_]{3,20}$"
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 50
        },
        "photoURL": {
          "type": "string",
          "maxLength": 500
        },
        "about": {
          "type": "string",
          "maxLength": 140
        },
        "isOnline": {
          "type": "boolean"
        },
        "isDiscoverable": {
          "type": "boolean"
        },
        "lastSeen": {
          "type": "string",
          "format": "date-time"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "username", "displayName", "isOnline", "isDiscoverable", "lastSeen", "createdAt", "updatedAt"]
    },
    "UsernameEntry": {
      "title": "UsernameEntry",
      "description": "Unique username registry mapping lowercase handles to user UIDs for search and new chats.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "username": {
          "type": "string",
          "minLength": 3,
          "maxLength": 20,
          "pattern": "^[a-z0-9_]{3,20}$"
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 50
        },
        "photoURL": {
          "type": "string",
          "maxLength": 500
        },
        "about": {
          "type": "string",
          "maxLength": 140
        },
        "isDiscoverable": {
          "type": "boolean"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "username", "displayName", "isDiscoverable", "createdAt", "updatedAt"]
    },
    "Chat": {
      "title": "Chat",
      "description": "Direct 1-on-1 conversation metadata between two participants.",
      "type": "object",
      "properties": {
        "chatId": {
          "type": "string",
          "minLength": 3,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "participants": {
          "type": "array",
          "description": "Exactly two participant UIDs sorted alphabetically."
        },
        "createdBy": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "lastMessageText": {
          "type": "string",
          "maxLength": 1000
        },
        "lastMessageSenderId": {
          "type": "string",
          "maxLength": 128
        },
        "lastMessageAt": {
          "type": "string",
          "format": "date-time"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["chatId", "participants", "createdBy", "lastMessageText", "lastMessageSenderId", "lastMessageAt", "createdAt", "updatedAt"]
    },
    "ChatMemberState": {
      "title": "ChatMemberState",
      "description": "Per-participant typing indicator, unread count, and read timestamp for a chat.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "chatId": {
          "type": "string",
          "minLength": 3,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "isTyping": {
          "type": "boolean"
        },
        "unreadCount": {
          "type": "integer"
        },
        "lastReadAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "chatId", "isTyping", "unreadCount", "lastReadAt", "updatedAt"]
    },
    "ChatMessage": {
      "title": "ChatMessage",
      "description": "Individual message inside a direct chat conversation.",
      "type": "object",
      "properties": {
        "messageId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "chatId": {
          "type": "string",
          "minLength": 3,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "senderId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "status": {
          "type": "string",
          "enum": ["sent", "read"]
        },
        "isDeleted": {
          "type": "boolean"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "readAt": {
          "type": "string",
          "format": "date-time"
        },
        "editedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["messageId", "chatId", "senderId", "text", "status", "isDeleted", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserPrivate" },
      "description": "Owner-isolated private user profiles containing email PII."
    },
    "/publicProfiles/{userId}": {
      "schema": { "$ref": "#/entities/PublicProfile" },
      "description": "Public non-PII user profiles for real-time presence, avatar, and username display."
    },
    "/usernames/{username}": {
      "schema": { "$ref": "#/entities/UsernameEntry" },
      "description": "Unique lowercase username lookup and prefix-search directory."
    },
    "/chats/{chatId}": {
      "schema": { "$ref": "#/entities/Chat" },
      "description": "Direct 1-on-1 chat threads keyed by sorted participant UIDs."
    },
    "/chats/{chatId}/memberStates/{userId}": {
      "schema": { "$ref": "#/entities/ChatMemberState" },
      "description": "Per-participant typing, unread counter, and last-read timestamp state."
    },
    "/chats/{chatId}/messages/{messageId}": {
      "schema": { "$ref": "#/entities/ChatMessage" },
      "description": "Messages belonging to a direct chat."
    }
  }
}
